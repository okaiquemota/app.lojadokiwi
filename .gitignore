# Arquivos temporários do sistema operacional
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*~

# Cache do Python (gerado pelos scripts em ferramentas/)
__pycache__/
*.py[cod]
.venv/
venv/

# Imagens originais antes de passar pelo otimizar-imagens.py.
# Guarde os originais fora do repositório: eles não vão ao ar e
# pesariam megabytes por arquivo.
originais/
*.psd
*.ai

# Node, caso algum dia entre alguma ferramenta
node_modules/
package-lock.json
npm-debug.log*

# PDFs fabricados: são o que se vende, ficam só no cofre (R2), nunca no site público
fabrica/saida/

# Configuração local do Worker (wrangler)
checkout/.wrangler/
checkout/.dev.vars
